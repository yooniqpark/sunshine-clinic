# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
__pycache__/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev DB + user uploads
prisma/dev.db
prisma/dev.db-journal
prisma/blog-test.db*
.blog-source/
prisma/prisma/
public/uploads

# work artifacts — root-level screenshots, recordings, playwright outputs
/*.png
/*.jpg
/*.jpeg
.playwright-mcp/
playwright-report/
test-results/
_demo-record.ts

# clinic-core sync 가 복사하는 파일
prisma/core.prisma
