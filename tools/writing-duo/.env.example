# 이 파일을 복사해서 이름을 ".env" 로 바꾼 뒤, 아래 키를 채워 넣으세요.

# Claude API 키 (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=여기에_클로드_키

# OpenAI API 키 (https://platform.openai.com → API keys)
OPENAI_API_KEY=여기에_오픈AI_키

# ── 아래는 바꾸지 않아도 됩니다 ──

# 작가 역할을 누가 할지: claude 또는 gpt (편집자는 자동으로 나머지가 맡음)
WRITER=claude

# 사용할 모델 이름
CLAUDE_MODEL=claude-opus-5-5
GPT_MODEL=gpt-5

# 목표 점수(10점 만점 평균)와 최대 수정 횟수
TARGET_SCORE=8.5
MAX_REVISIONS=3
