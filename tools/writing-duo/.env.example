# 이 파일은 없어도 됩니다. 기본값을 바꾸고 싶을 때만 이름을 ".env" 로 바꿔서 고치세요.
# API 키는 필요 없습니다. Claude·ChatGPT 구독 계정으로 로그인해서 씁니다 (로그인하기.bat).

# 진행 방식: debate(둘이 토론) 또는 loop(한쪽이 쓰고 한쪽이 채점)
MODE=debate

# 토론 라운드 수 (1~4, 많을수록 구독 사용량을 많이 씀)
DEBATE_ROUNDS=2

# loop 모드에서 작가 역할 / debate 모드에서 점수가 같을 때 최종 정리 담당: claude 또는 gpt
WRITER=claude

# 목표 점수(10점 만점 평균)와 loop 모드 최대 수정 횟수
TARGET_SCORE=8.5
MAX_REVISIONS=3

# 모델 이름. 비워두면 구독 기본 모델을 씁니다 (예: CLAUDE_MODEL=opus, GPT_MODEL=gpt-5.5)
CLAUDE_MODEL=
GPT_MODEL=

# 글에 들어갈 병원 소개
CLINIC_PROFILE=선샤인의원 — 서울 송파구 잠실 서일빌딩 10층의 피부과 의원 (피부 시술·레이저·보톡스 등)
