# Copy to .env.local (dev) or .env (production)
# Never commit real values.

# ───── Database ─────
# Local SQLite (default). For production:
#   • Lightsail/EC2 server: file:./prisma/dev.db
#   • Managed Postgres:     postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL="file:./prisma/dev.db"

# ───── NextAuth (credentials login for /admin) ─────
# Generate a fresh secret: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-base64-secret"
# Public URL of the site. Use http://localhost:3000 (dev) or https://your-domain.com (prod).
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ───── Qwen (Alibaba Model Studio) ─────
# Powers the chatbot (/api/chat) via the OpenAI-compatible endpoint.
QWEN_API_KEY="sk-..."
# Optional overrides (defaults shown):
# QWEN_MODEL="qwen3.7-plus"
# QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"

# ───── OpenAI ─────
# Powers admin auto-translate (/api/admin/translate).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-..."

# ───── Admin credentials (server-only, never sent to browser) ─────
# Used by prisma/seed.ts to upsert the admin account. Change these on the
# production server's .env directly — do NOT commit real values.
ADMIN_USERNAME="sunshineadmin"
ADMIN_PASSWORD="change-me"
